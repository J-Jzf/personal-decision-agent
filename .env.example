# OpenAI-compatible LLM connection. Leave LLM_API_KEY blank for offline fallback.
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# Local, rebuildable runtime data.
SQLITE_PATH=var/personal_decision.db
QDRANT_PATH=var/qdrant

# JSON list of local stdio MCP server command configurations.
MCP_COMMANDS_JSON=[]
REQUEST_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=60
REACT_CALL_LIMIT=3
REPLAN_LIMIT=3
HITL_TIMEOUT_SECONDS=30
HITL_REQUEST_LIMIT=2
